# Copy to .env.preview or .env.preprod and fill in one of the two secrets.
# Never commit the filled-in file. The local network needs no secrets.

# Wallet mnemonic for the test network (12 or 24 words).
# MIDNIGHT_PREVIEW_MNEMONIC=
# MIDNIGHT_PREPROD_MNEMONIC=

# Or a hex seed (no 0x prefix) instead of a mnemonic. Set only one.
# MIDNIGHT_PREVIEW_SEED=
# MIDNIGHT_PREPROD_SEED=

# Proof server URL. Default is the local proof server from compose.yml.
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# Network to run against: local, preview, or preprod.
# MIDNIGHT_NETWORK=preprod
